\@writefile{toc}{\contentsline {section}{\numberline {4.1}例一：$f(x)=x^{2}/2$（处处良性）}{5}{section.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces 固定斜率 $p=1$：上下平移直线 $y=x-c$。因 $c$ 越大直线越低，故``最高''仿射下界对应\emph  {最小允许}的 $c$，即 $c=f^{\ast }(1)=1/2$。}}{5}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:quad-shift}{{4.1}{5}{固定斜率 $p=1$：上下平移直线 $y=x-c$。因 $c$ 越大直线越低，故``最高''仿射下界对应\emph {最小允许}的 $c$，即 $c=f^{\ast }(1)=1/2$。}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces $f(x)=x^{2}/2$：不同斜率 $p=-1,0,1.5$ 各自的最高仿射下界（本例中均为支撑直线）。切点依次为 $x=p$。}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:quad-multi}{{4.2}{5}{$f(x)=x^{2}/2$：不同斜率 $p=-1,0,1.5$ 各自的最高仿射下界（本例中均为支撑直线）。切点依次为 $x=p$。}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}例二：$f(x)=\mathrm  {e}^{x}$（暴露边界）}{6}{section.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces $f(x)=\mathrm  {e}^{x}$ 三种斜率。左：$p=\mathrm  {e}>0$，切线相贴（支撑）。中：$p=0$，水平线 $y=0$ 是最高仿射下界但不接触。右：$p<0$，负斜率直线向左上冲，无法成为全局下界。}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:exp}{{4.3}{6}{$f(x)=\mathrm {e}^{x}$ 三种斜率。左：$p=\mathrm {e}>0$，切线相贴（支撑）。中：$p=0$，水平线 $y=0$ 是最高仿射下界但不接触。右：$p<0$，负斜率直线向左上冲，无法成为全局下界。}{figure.caption.4}{}}
